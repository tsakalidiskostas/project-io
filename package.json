{
  "name": "project-io",
  "version": "0.1.0",
  "private": true,
  "description": "A local, Claude-powered app that explains pull requests — and can edit itself.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env scripts/supervisor.ts",
    "serve": "node --env-file-if-exists=.env src/server.ts",
    "claude": "node scripts/claude.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.283",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
